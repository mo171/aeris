# The shape of a working `.env`, with no real values in it.
#
# what  : Every variable `app/config.py` reads, in the same order, with a local-development value or a
#         placeholder. Copy to `.env` and fill in.
# where : Committed; `.env` is not. This file is the only documentation of the backend's configuration
#         surface, so a variable added to `config.py` and not added here is an unreported requirement.
# how   : Values marked CHANGE-ME are secrets and must never be committed with a real value. Variables with
#         no default in `config.py` - the two Inngest keys - are mandatory: importing `config` without them
#         raises at import and names the missing field.

# --- Identity ----------------------------------------------------------------------------------------
PROJECT_NAME="SatQuery AI (AERIS)"
VERSION="1.0.0"

# --- Deployment shape --------------------------------------------------------------------------------
# local | development | staging | production
ENVIRONMENT=local
DEBUG=True

# --- Logging ------------------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
# json | console. Use `json` anywhere logs are collected; `console` only for a local terminal.
LOG_FORMAT=console

# --- Inngest (Phase 0.5) ------------------------------------------------------------------------------
# The literal string `local` is correct for the Inngest dev server. CHANGE-ME for any deployed environment.
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"

# --- Database (Phase 0.2) -----------------------------------------------------------------------------
# Postgres with PostGIS. Required - importing `app.config` without it raises and names the field.
#
# Local: the `postgis` service in docker-compose.yml. Run `docker compose up -d` first.
# Deployed: the Supabase connection string, with `+asyncpg` added to the scheme. Supabase gives you a
#           `postgresql://` URL; the driver suffix is mandatory here and is validated at import.
#
# CHANGE-ME in any deployed environment - the local password below is committed on purpose and is not a
# secret, because it only ever reaches a container bound to 127.0.0.1.
DATABASE_URL="postgresql+asyncpg://aeris:aeris_local_development@localhost:5433/aeris"

# Connection pool. Raise deliberately: asyncpg holds a real connection per slot and Supabase's session-mode
# pooler counts them against the project limit.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Prints every statement AND its parameter values. Never enable where logs are collected.
DATABASE_ECHO_SQL=False

# --- Redis (Phase 0.3) --------------------------------------------------------------------------------
# One server, two unrelated uses kept apart by key prefix: distributed locks around the GPU, and a
# short-lived cache. Required - importing `app.config` without it raises and names the field.
#
# Local: the `redis` service in docker-compose.yml, which starts with `--maxmemory-policy noeviction`.
#        That policy is not decoration: any other setting lets Redis evict a lock a process is still
#        holding. `aeris doctor` reads the live value and says so.
# Deployed: a managed Redis. Use `rediss://` for TLS, and confirm the eviction policy with the provider -
#           several disable `CONFIG GET`, so it cannot be verified from here.
REDIS_URL="redis://localhost:6379/0"

# Seconds a cache entry lives when the call site does not name a TTL. Every cache write gets one.
REDIS_CACHE_DEFAULT_TTL_SECONDS=300

# Seconds a lock is held before Redis expires it. Sized for the longest legitimate critical section - a
# model load onto an 8 GB card - because the same number is also how long a crashed holder blocks everyone.
REDIS_LOCK_TIMEOUT_SECONDS=120

# Seconds an acquirer waits before giving up. Running out raises; it never proceeds unlocked.
REDIS_LOCK_BLOCKING_TIMEOUT_SECONDS=30

REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=20

# --- Object storage (Phase 0.4) -----------------------------------------------------------------------
# Written against the S3 API, not against MinIO. Locally the `minio` service in docker-compose.yml;
# deployed it is S3, R2 or Supabase Storage with no code change.
STORAGE_ENDPOINT_URL="http://localhost:9000"

# CHANGE-ME in any deployed environment. The local values below are committed on purpose and are not
# secrets - they only ever reach a container bound to 127.0.0.1 - but they are also what `docker-compose.yml`
# starts MinIO with, so the two files have to agree.
STORAGE_ACCESS_KEY="aeris_local_development"
STORAGE_SECRET_KEY="aeris_local_development_secret"

# The endpoint a browser can reach, when it differs from the one this process uses. A presigned URL's
# signature covers the host, so a URL signed for `http://minio:9000` cannot be repaired afterwards by
# swapping the hostname - it has to be signed against this one. Leave unset while the backend runs on the
# host; set it to `http://localhost:9000` once the backend itself moves into the compose network.
# STORAGE_PUBLIC_ENDPOINT_URL="http://localhost:9000"

# SigV4 has no valid empty region. MinIO ignores the value; S3 does not.
STORAGE_REGION="us-east-1"

# Buckets are `{prefix}-{role}` over the five roles in app/constants/storage.py:
# aeris-raw, aeris-cog, aeris-artefacts, aeris-figures, aeris-reports.
STORAGE_BUCKET_PREFIX="aeris"

# `path` for MinIO, which cannot serve `bucket.host/key`. Real S3 prefers `virtual`.
STORAGE_ADDRESSING_STYLE="path"

# The origin the browser loads the interface from. Read twice: docker-compose.yml passes it to MinIO as
# MINIO_API_CORS_ALLOW_ORIGIN, and app/lib/storage.py probes with it to prove CORS actually works.
STORAGE_BROWSER_ORIGIN="http://localhost:3000"

# Presigned URL lifetimes. The upload one is long because it has to cover the transfer itself; an expiry
# that lapses mid-upload fails at the end of it.
STORAGE_PRESIGNED_GET_EXPIRY_SECONDS=3600
STORAGE_PRESIGNED_PUT_EXPIRY_SECONDS=21600

STORAGE_CONNECT_TIMEOUT_SECONDS=10
STORAGE_READ_TIMEOUT_SECONDS=60

# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Backend API ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# ── Phase 1 mock transport (delete these together with the /mock folder) ─────
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_MOCK_LATENCY_MS=280
NEXT_PUBLIC_MOCK_SCENE_COUNT=5000
NEXT_PUBLIC_MOCK_MARKER_COUNT=300

# ── 3D Earth (CesiumJS) ──────────────────────────────────────────────────────
# Optional, but this is the switch between a real Earth and a fallback.
#   set   -> Ion world imagery + real elevation terrain (the intended experience)
#   unset -> dark raster basemap on a smooth ellipsoid: real geography, but flat
# Free tokens: https://ion.cesium.com
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# ── AERIS Voice (Jarvis) ─────────────────────────────────────────────────────
# Soft, warm British delivery. ash is the default base (clear and audible on
# small speakers; British softness comes from the style instruction). Try
# without a code change: ballad (most British-sounding, younger), cedar
# (warmest, newest), onyx (deepest). Speed slightly under 1.0 aids clarity.
# gpt-4o-mini-tts applies the style instruction; the route falls back to
# tts-1-hd automatically if needed.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# OPENAI_VOICE=ash
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_SPEED=0.95

# Google Maps API key — ONLY used for Photorealistic 3D Tiles in the investigation workspace.
# Optional and off by default. Photorealistic tiles are a PRESENTATION mode: metered per tile, and they
# replace the ground, which suspends the operator's own imagery and the before/after comparator.
# Building massing (OpenStreetMap, free) stays the analysis default and needs nothing here.
# Get a key from a Google Cloud project with the Map Tiles API enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ElevenLabs TTS ──────────────────────────────────────────────────────────────
# Get a key from https://elevenlabs.io
# ELEVENLABS_API_KEY=sk_e061f98f900bdeb6f66b927ba2e72288f5a553dab0262760
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=uGA0BTw0auurBhSTFN7g   # Archie advertisement voice
